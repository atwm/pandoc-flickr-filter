cabal-version: 2.4
name:          pandoc-flickr-filter
version:       0.1.0.0
author:        Andrew Maier
maintainer:    andrew@maier.name

library
    exposed-modules:  FlickrFilter
    hs-source-dirs:   .
    default-language: Haskell2010
    build-depends:
          base                  >= 4
        , aeson                 >= 1.5
        , bytestring            >= 0.10
        , HsOpenSSL             >= 0.11
        , HsOpenSSL-x509-system >= 0.1
        , http-client           >= 0.7
        , http-client-openssl   >= 0.3
        , pandoc-types          >= 1.22
        , text                  >= 1.0

executable pandoc-flickr-filter
    main-is:          Main.hs
    other-modules:    FlickrFilter
    hs-source-dirs:   .
    GHC-Options:      -threaded -rtsopts -with-rtsopts=-N
    default-language: Haskell2010
    build-depends:
          base                  >= 4
        , aeson                 >= 1.5
        , bytestring            >= 0.10
        , HsOpenSSL             >= 0.11
        , HsOpenSSL-x509-system >= 0.1
        , http-client           >= 0.7
        , http-client-openssl   >= 0.3
        , pandoc-flickr-filter
        , pandoc-types          >= 1.22
        , text                  >= 1.0

